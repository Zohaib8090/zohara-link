# After an update, the old zohara-linkd keeps running in memory (it shows as "(deleted)") and refuses the phone's newer requests,
# for example the ZoAI Profiles list. Restart it for every signed-in user. try-restart does nothing if the service is not running,
# so a machine that does not use Zohara Link is left alone. Errors are ignored: an update must never fail because of this.
post_upgrade() {
  command -v loginctl >/dev/null 2>&1 || return 0
  for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
    systemctl --user --machine="${user}@.host" try-restart zohara-linkd.service >/dev/null 2>&1 || true
  done
  return 0
}
