# Maintainer: Zohara OS Team <https://github.com/Zohaib8090/zohara-link>
pkgname=zohara-linkd
pkgver=0.1.0
pkgrel=1
pkgdesc="Zohara Link Linux companion daemon (pairs with the Zohara Link Android app)"
arch=('x86_64')
url="https://github.com/Zohaib8090/zohara-link"
license=('MIT' 'GPL-3.0-or-later')
# These are what the buttons on the phone run: media keys (playerctl), the clipboard (wl-clipboard), the pointer (ydotool) and
# desktop notifications (libnotify). All are in the Arch repositories and the ISO already has them; listing them here makes an
# update install them on machines that do not.
# gstreamer and the two -libs packages are what the live stream program (zohara-linkd-stream) links to; the plugins it needs at
# run time are installed by the "Set up game streaming" button in Settings (they are large), see docs/STREAMING.md.
depends=('gcc-libs' 'playerctl' 'wl-clipboard' 'ydotool' 'libnotify' 'spectacle' 'gstreamer' 'gst-plugins-base-libs' 'gst-plugins-bad-libs')
makedepends=('cargo')
optdepends=(
  'xclip: clipboard sync on X11'
  'xdotool: remote pointer control on X11'
  'gst-plugins-bad: game streaming (WebRTC)'
  'gst-plugin-pipewire: game streaming (screen capture)'
  'gst-plugin-va: game streaming (Intel/AMD hardware video encoder)'
  'gst-plugins-ugly: game streaming (software video encoder, last resort)'
  'hyprlock: proximity screen lock (Hyprland)'
  'swaylock: proximity screen lock (sway)'
)
options=(!lto)
backup=()
source=()
sha256sums=()

pkgver() {
  # CI passes _PKGVER (Cargo version + build time) so every build is an update for pacman.
  if [ -n "${_PKGVER:-}" ]; then echo "$_PKGVER"; else grep '^version' "$startdir/Cargo.toml" | head -1 | cut -d'"' -f2; fi
}

build() {
  cd "$startdir"
  cargo build --release --locked
}

package() {
  install -Dm755 "$startdir/target/release/zohara-linkd" "$pkgdir/usr/bin/zohara-linkd"
  install -Dm755 "$startdir/target/release/zohara-linkd-stream" "$pkgdir/usr/bin/zohara-linkd-stream"
  install -Dm755 "$startdir/target/release/zohara-link-status" "$pkgdir/usr/bin/zohara-link-status"
  install -Dm644 "$startdir/zohara-linkd.service" "$pkgdir/usr/lib/systemd/user/zohara-linkd.service"
}
